# ── Transcription ────────────────────────────
# faster-whisper model: tiny | base | small | medium
# 'base' recommended (145 MB, good accuracy, <10s on CPU)
TRANSCRIPTION_MODEL=base

# ── Silence Detection ─────────────────────────
# Seconds of silence before recording auto-stops
SILENCE_THRESHOLD_SECONDS=5.0

# ── LLM Scoring (Ollama) ─────────────────────
# Install Ollama from https://ollama.com, then: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ── LLM Scoring (HuggingFace fallback) ───────
# Get a free token at https://huggingface.co/settings/tokens
# Leave empty to skip HF and use rule-based scoring
HF_TOKEN=

# ── Best Responses ────────────────────────────
# Minimum overall score (0–10) to offer saving
BEST_RESPONSE_MIN_SCORE=7.0
